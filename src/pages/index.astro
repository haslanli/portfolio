---
import '../styles/global.css';
import Field from '../components/Field.astro';
import EntryBody from '../components/EntryBody.astro';
import WorkArchive from '../components/WorkArchive.astro';
import SkillsList from '../components/SkillsList.astro';
import { identity, lede, description, work, skills, additionalSkills, education, profileButtons, footerLinks } from '../data/content';

/** Numeric character references: the address never appears as a plain literal. */
const entities = (s: string) =>
  Array.from(s)
    .map((c) => `&#${c.codePointAt(0)};`)
    .join('');

const address = `${identity.emailUser}@${identity.emailDomain}`;
const emailText = entities(address);
const emailHref = entities(`mailto:${address}`);

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Huseyn Aslanli</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f5f3ee" />
    <link rel="preload" href="/fonts/satoshi-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link
      rel="preload"
      href="/fonts/newsreader-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content="Huseyn Aslanli" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <main class="sheet">
      <header class="head">
        <div class="grid">
          <h1 class="name">Huseyn Aslanli</h1>

          <p class="standfirst">
            {identity.role}<span class="sep">/</span><span class="quiet"
              >{identity.descriptor}</span
            >
          </p>

          <p class="lede">{lede}</p>

          <dl class="facts">
            <div>
              <dt>Education</dt>
              <dd>{identity.degree}. Graduating {identity.graduation}.</dd>
            </div>
            <div>
              <dt>Based in</dt>
              <dd>{identity.location}</dd>
            </div>
          </dl>

          <div class="contact">
            <Fragment
              set:html={`<a class="block block--loud" href="${emailHref}">${emailText}</a>`}
            />
            {
              profileButtons.map((l) => (
                <a class="block" href={l.href} rel="me noopener">
                  {l.label}
                </a>
              ))
            }
          </div>

          <Field />
        </div>
      </header>

      <section class="section" aria-labelledby="featured-h">
        <div class="grid">
          <h2 class="marginal" id="featured-h">Featured</h2>

          {
            work.filter((entry) => entry.featured).map((entry, i) => (
              <article id={entry.id} class:list={['entry', 'reveal', i === 0 && 'entry--lead']}>
                <div class="entry__stub">
                  <h3 class="entry__org">{entry.org}</h3>
                  <p class="entry__role">{entry.role}</p>
                  <p class="entry__dates">{entry.dates}</p>
                  {entry.meta && <p class="entry__meta">{entry.meta}</p>}
                </div>

                <div class="entry__body">
                  <EntryBody entry={entry} />
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section" aria-labelledby="archive-h">
        <div class="grid">
          <h2 class="marginal" id="archive-h">More work</h2>
          <WorkArchive />
        </div>
      </section>

      <section class="section" aria-labelledby="skills-h">
        <div class="grid">
          <h2 class="marginal" id="skills-h">Skills</h2>
          <div class="skills-content">
            <SkillsList groups={skills} />
            <details class="skills-more" id="additional-skills">
              <summary class="skills-more__summary">
                <span>Additional skills</span>
                <svg class="skills-more__chevron" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div class="disclosure-content" data-disclosure-content>
                <SkillsList groups={additionalSkills} />
              </div>
            </details>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="edu-h">
        <div class="grid">
          <h2 class="marginal" id="edu-h">Education</h2>
          <div class="edu">
            <p class="edu__degree">{education.degree}</p>
            <p class="edu__school">{education.school}</p>
            <p class="edu__dates">{education.dates}</p>
          </div>
          <dl class="edu__aside">
            <dt>Completed coursework</dt>
            <dd>{education.completedCoursework}</dd>
            <dt>In progress</dt>
            <dd>{education.currentCoursework}</dd>
          </dl>
        </div>
      </section>
    </main>

    <footer class="foot sheet">
      <div class="grid">
        <div class="foot__contact">
          <Fragment set:html={`<a class="plain-link" href="${emailHref}">${emailText}</a>`} />
          {
            footerLinks.map((l) => (
              <a class="plain-link" href={l.href} rel="me noopener">
                {l.label}
              </a>
            ))
          }
        </div>
      </div>
    </footer>

    <script>
      import { Disclosure } from '../scripts/disclosure';

      const additionalSkills = document.querySelector<HTMLDetailsElement>('#additional-skills');
      if (additionalSkills) new Disclosure(additionalSkills);

      const revealables = document.querySelectorAll<HTMLElement>('.reveal');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        revealables.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        revealables.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
